NEXT_PUBLIC_API_URL=http://localhost:5100/api
NEXT_PUBLIC_APP_NAME=EasyFix CRM

# Google Maps JS API key (browser-side, referer-restricted).
# NOT interchangeable with EasyFix_Backend's `GOOGLE_MAPS_API_KEY` — that one
# is server-side (Places + Geocoding via REST) and CANNOT be referer-
# restricted because HTTP referer restrictions are a browser-only Google
# enforcement layer. A referer-restricted key used from the BE returns
# `REQUEST_DENIED · API keys with referer restrictions…` no matter what
# domains you add to the allowlist.
#
# Two valid setups:
#   (a) Two keys — this one referer-restricted (Maps JS only), and a
#       separate server-side key (IP-restricted or App Restrictions=None,
#       Places + Geocoding only) in EasyFix_Backend's `.env` as
#       `GOOGLE_MAPS_API_KEY`.
#   (b) Single shared key — App Restrictions=None + API restrictions
#       narrowed to (Maps JS + Places + Geocoding only). This is the
#       path EasyFix currently uses + a GCP budget alert capping spend
#       at ₹2k/mo as the cost backstop.
#
# Required for: Google Maps surfaces in the CRM (e.g. Job address picker,
# Easyfixer city/pincode preview). Without it, those surfaces silently
# fail to render with a console error from the Maps JS loader.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
